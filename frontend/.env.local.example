# Copy to .env.local. Only NEXT_PUBLIC_* vars reach the browser - never put secrets here.
#
# The backend origin. This is the ONLY source of the API URL; there is no
# hardcoded fallback outside development.
# Local:      http://localhost:8000
# Production: the deployed backend's Vercel URL or custom domain.
NEXT_PUBLIC_API_URL=http://localhost:8000
