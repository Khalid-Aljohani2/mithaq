# Copy to .env and fill in. Never commit the real .env.

# Postgres. Use the POOLED connection string from your provider, with SSL.
# Leave empty to fall back to the in-memory store (local only - a Vercel
# Function keeps no memory between requests, so production must set this).
# A postgres:// or postgresql:// prefix is rewritten to postgresql+psycopg://
# automatically, so paste the provider's string as-is.
DATABASE_URL=

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000

# Shared secret for POST /api/demo/reset. Leave empty to disable the endpoint
# entirely (it then returns 404).
DEMO_RESET_TOKEN=

# Local demos only. When true, POST /api/demo/reset accepts requests from
# localhost (127.0.0.1 / ::1) without the token, so the browser never needs it.
# Requests from any other address still need DEMO_RESET_TOKEN. Never set this
# on a deployed instance.
DEMO_MODE=false

LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Hours an approval step may wait before a reminder appears. Leave empty to use
# the organisation policy file (24). Set to 0 for a demo, so reminders show up
# immediately instead of a day later.
REMINDER_PENDING_APPROVAL_HOURS=

# Hours a request may wait on its documents before a reminder appears. Leave
# empty to use the policy file (48). Set to 0 for a demo.
REMINDER_AWAITING_DOCUMENTS_HOURS=
